# ──────────────────────────────────────────────────────────────
# Disha Production Environment Variables Template
# Copy to .env and fill in real secrets before deploying
# ──────────────────────────────────────────────────────────────

# Required: Google Gemini API Key for LLM extraction, learning roadmaps, and resume judge
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com

# PostgreSQL + pgvector Database URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@db:5432/disha_db

# User Memory Storage Directory
DISHA_DATA_DIR=/app/data

# Frontend Configuration (Build-time)
NEXT_PUBLIC_API_URL=http://localhost:8000
